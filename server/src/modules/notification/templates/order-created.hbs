<div style="font-family: Arial, sans-serif; padding: 20px;">
  <h2>New Order Received</h2>
  <p>Order <strong>#{{orderNumber}}</strong> has been placed.</p>
  <p><strong>Type:</strong> {{orderType}}</p>
  <p><strong>Total:</strong> {{currency}} {{totalAmount}}</p>
  <a href="{{posUrl}}/orders/{{orderId}}" style="display:inline-block; padding: 10px 15px; background: #007bff; color: #fff; text-decoration: none; border-radius: 5px;">View Order</a>
</div>
