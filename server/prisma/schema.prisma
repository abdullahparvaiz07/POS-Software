model SizeTemplate {
  id        Int                @id @default(autoincrement())
  name      String             @unique @db.VarChar(100)
  items     SizeTemplateItem[]
  menuItems MenuItem[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?

  @@map("size_templates")
}

model SizeTemplateItem {
  id           Int          @id @default(autoincrement())
  templateId   Int
  name         String       @db.VarChar(100)
  displayOrder Int          @default(0)
  template     SizeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, name])
  @@map("size_template_items")
}

model ModifierGroup {
  id            Int                     @id @default(autoincrement())
  name          String                  @unique @db.VarChar(100)
  minSelections Int                     @default(0)
  maxSelections Int                     @default(1)
  modifiers     Modifier[]
  menuItems     MenuItemModifierGroup[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  deletedAt     DateTime?

  @@map("modifier_groups")
}

model Modifier {
  id          Int           @id @default(autoincrement())
  groupId     Int
  name        String        @db.VarChar(100)
  price       Decimal       @default(0.00) @db.Decimal(10, 2)
  isAvailable Boolean       @default(true)
  group       ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, name])
  @@map("modifiers")
}

model MenuItemModifierGroup {
  menuItemId      Int
  modifierGroupId Int
  displayOrder    Int           @default(0)
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([menuItemId, modifierGroupId])
  @@map("menu_item_modifier_groups")
}
