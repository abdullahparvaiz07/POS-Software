generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int             @id @default(autoincrement())
  fullName              String          @db.VarChar(150)
  phone                 String          @unique @db.VarChar(20)
  email                 String?         @unique @db.VarChar(255)
  password              String          @db.VarChar(255)
  address               String?         @db.Text
  salary                Decimal?        @db.Decimal(10, 2)
  joiningDate           DateTime        @db.Date
  status                UserStatus      @default(ACTIVE)
  lastLoginAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?
  profilePhoto          String?         @db.VarChar(255)
  auditLogs             AuditLog[]
  backups               Backup[]
  assignedBarQueues     BarQueue[]
  createdCategories     Category[]      @relation("CategoryCreatedBy")
  updatedCategories     Category[]      @relation("CategoryUpdatedBy")
  createdIngredients    Ingredient[]    @relation("IngredientCreatedBy")
  updatedIngredients    Ingredient[]    @relation("IngredientUpdatedBy")
  assignedKitchenQueues KitchenQueue[]
  createdMenuItems      MenuItem[]      @relation("MenuItemCreatedBy")
  updatedMenuItems      MenuItem[]      @relation("MenuItemUpdatedBy")
  createdMenuVariants   MenuVariant[]   @relation("MenuVariantCreatedBy")
  updatedMenuVariants   MenuVariant[]   @relation("MenuVariantUpdatedBy")
  notifications         Notification[]
  assignedOrders        Order[]         @relation("OrderAssignedStaff")
  waiterOrders          Order[]         @relation("OrderWaiter")
  riderOrders           Order[]         @relation("OrderDeliveryRider")
  staffAssignedOrders   Order[]         @relation("OrderAssignedBy")
  createdOrders         Order[]         @relation("OrderCreatedBy")
  updatedOrders         Order[]         @relation("OrderUpdatedBy")
  printJobs             PrintJob[]
  createdPurchases      Purchase[]      @relation("PurchaseCreatedBy")
  updatedPurchases      Purchase[]      @relation("PurchaseUpdatedBy")
  createdRecipes        Recipe[]        @relation("RecipeCreatedBy")
  updatedRecipes        Recipe[]        @relation("RecipeUpdatedBy")
  createdStockMovements StockMovement[] @relation("StockMovementCreatedBy")
  createdSuppliers      Supplier[]      @relation("SupplierCreatedBy")
  updatedSuppliers      Supplier[]      @relation("SupplierUpdatedBy")
  userRoles             UserRole[]

  @@index([phone])
  @@index([status])
  @@map("users")
}

model Role {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(50)
  description String?    @db.Text
  isSystem    Boolean    @default(true)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  permissions Json?
  userRoles   UserRole[]

  @@index([name])
  @@map("roles")
}

model UserRole {
  id         Int      @id @default(autoincrement())
  userId     Int
  roleId     Int
  assignedAt DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Category {
  id            Int        @id @default(autoincrement())
  name          String     @unique @db.VarChar(100)
  slug          String     @unique @db.VarChar(120)
  description   String?    @db.Text
  icon          String?    @db.VarChar(100)
  color         String?    @db.VarChar(20)
  image         String?    @db.VarChar(255)
  displayOrder  Int        @default(0)
  isActive      Boolean    @default(true)
  isCustom      Boolean    @default(false)
  createdBy     Int
  updatedBy     Int
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?
  createdByUser User       @relation("CategoryCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User       @relation("CategoryUpdatedBy", fields: [updatedBy], references: [id])
  menuItems     MenuItem[]
  parentId      Int?
  parent        Category?  @relation("SubCategories", fields: [parentId], references: [id])
  subCategories Category[] @relation("SubCategories")

  @@index([name])
  @@index([slug])
  @@index([isActive])
  @@index([displayOrder])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([parentId])
  @@map("categories")
}

model MenuItem {
  id              Int                     @id @default(autoincrement())
  categoryId      Int
  name            String                  @unique @db.VarChar(150)
  slug            String                  @unique @db.VarChar(170)
  sku             String?                 @unique @db.VarChar(50)
  description     String?                 @db.Text
  image           String?                 @db.LongText
  preparationArea PreparationArea
  pricingMode     PricingMode
  isAvailable     Boolean                 @default(true)
  displayOrder    Int                     @default(0)
  createdBy       Int
  updatedBy       Int
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deletedAt       DateTime?
  category        Category                @relation(fields: [categoryId], references: [id])
  sizeTemplateId  Int?
  sizeTemplate    SizeTemplate?           @relation(fields: [sizeTemplateId], references: [id])
  createdByUser   User                    @relation("MenuItemCreatedBy", fields: [createdBy], references: [id])
  updatedByUser   User                    @relation("MenuItemUpdatedBy", fields: [updatedBy], references: [id])
  variants        MenuVariant[]
  orderItems      OrderItem[]
  recipes         Recipe[]
  modifierGroups  MenuItemModifierGroup[]

  @@index([categoryId])
  @@index([sizeTemplateId])
  @@index([name])
  @@index([slug])
  @@index([sku])
  @@index([preparationArea])
  @@index([pricingMode])
  @@index([isAvailable])
  @@index([displayOrder])
  @@index([createdBy], map: "menu_items_createdBy_fkey")
  @@index([updatedBy], map: "menu_items_updatedBy_fkey")
  @@map("menu_items")
}

model MenuVariant {
  id              Int         @id @default(autoincrement())
  menuItemId      Int
  name            String      @db.VarChar(100)
  sku             String?     @unique @db.VarChar(50)
  barcode         String?     @unique @db.VarChar(50)
  price           Decimal     @db.Decimal(10, 2)
  preparationTime Int?
  image           String?     @db.VarChar(255)
  displayOrder    Int         @default(0)
  isDefault       Boolean     @default(false)
  isAvailable     Boolean     @default(true)
  createdBy       Int
  updatedBy       Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  recipeId        Int?
  createdByUser   User        @relation("MenuVariantCreatedBy", fields: [createdBy], references: [id])
  menuItem        MenuItem    @relation(fields: [menuItemId], references: [id])
  recipe          Recipe?     @relation(fields: [recipeId], references: [id])
  updatedByUser   User        @relation("MenuVariantUpdatedBy", fields: [updatedBy], references: [id])
  orderItems      OrderItem[]

  @@unique([menuItemId, name])
  @@index([menuItemId])
  @@index([menuItemId, isAvailable])
  @@index([isAvailable])
  @@index([displayOrder])
  @@index([price])
  @@index([createdBy], map: "menu_variants_createdBy_fkey")
  @@index([recipeId], map: "menu_variants_recipeId_fkey")
  @@index([updatedBy], map: "menu_variants_updatedBy_fkey")
  @@map("menu_variants")
}

model Order {
  id               Int               @id @default(autoincrement())
  orderNumber      String            @unique @db.VarChar(50)
  orderType        OrderType
  takeawayMode     TakeawayMode?
  tableNumber      Int?
  customerName     String?           @db.VarChar(150)
  customerPhone    String?           @db.VarChar(20)
  assignedStaffId  Int?
  waiterId         Int?
  deliveryRiderId  Int?
  assignedById     Int?
  assignedAt       DateTime?
  assignmentMethod AssignmentMethod?
  subtotal         Decimal           @db.Decimal(10, 2)
  discountAmount   Decimal           @default(0.00) @db.Decimal(10, 2)
  taxAmount        Decimal           @default(0.00) @db.Decimal(10, 2)
  grandTotal       Decimal           @db.Decimal(10, 2)
  paymentStatus    PaymentStatus
  paymentMethod    PaymentMethod
  status           OrderStatus
  source           OrderSource       @default(POS)
  notes            String?           @db.Text
  createdBy        Int
  updatedBy        Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  servedAt         DateTime?
  completedAt      DateTime?
  orderItems       OrderItem[]
  assignedStaff    User?             @relation("OrderAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: Restrict)
  waiter           User?             @relation("OrderWaiter", fields: [waiterId], references: [id], onDelete: Restrict)
  deliveryRider    User?             @relation("OrderDeliveryRider", fields: [deliveryRiderId], references: [id], onDelete: Restrict)
  assignedBy       User?             @relation("OrderAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  createdByUser    User              @relation("OrderCreatedBy", fields: [createdBy], references: [id])
  updatedByUser    User              @relation("OrderUpdatedBy", fields: [updatedBy], references: [id])
  printJobs        PrintJob[]

  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([orderType])
  @@index([assignedStaffId])
  @@index([waiterId])
  @@index([deliveryRiderId])
  @@index([assignedById])
  @@index([createdAt])
  @@index([createdBy], map: "orders_createdBy_fkey")
  @@index([updatedBy], map: "orders_updatedBy_fkey")
  @@map("orders")
}

model OrderItem {
  id                 Int             @id @default(autoincrement())
  lineNumber         Int
  orderId            Int
  menuItemId         Int
  menuVariantId      Int?
  menuItemName       String          @db.VarChar(150)
  variantName        String?         @db.VarChar(100)
  customVariantName  String?         @db.VarChar(100)
  customVariantPrice Decimal?        @db.Decimal(10, 2)
  preparationArea    PreparationArea
  quantity           Int
  unitPrice          Decimal         @db.Decimal(10, 2)
  discountAmount     Decimal         @default(0.00) @db.Decimal(10, 2)
  taxAmount          Decimal         @default(0.00) @db.Decimal(10, 2)
  subtotal           Decimal         @db.Decimal(10, 2)
  notes              String?         @db.Text
  status             OrderItemStatus @default(PENDING)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  barQueue           BarQueue?
  kitchenQueue       KitchenQueue?
  menuItem           MenuItem        @relation(fields: [menuItemId], references: [id])
  menuVariant        MenuVariant?    @relation(fields: [menuVariantId], references: [id], onDelete: Restrict)
  order              Order           @relation(fields: [orderId], references: [id])

  @@unique([orderId, lineNumber])
  @@index([orderId])
  @@index([menuItemId])
  @@index([menuVariantId])
  @@index([status])
  @@index([preparationArea])
  @@index([createdAt])
  @@map("order_items")
}

model OrderCounter {
  id           Int      @id @default(autoincrement())
  businessDate DateTime @unique @db.Date
  lastSequence Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessDate])
  @@map("order_counters")
}

model KitchenQueue {
  id             Int             @id @default(autoincrement())
  orderItemId    Int             @unique
  assignedChefId Int?
  status         KitchenStatus   @default(PENDING)
  priority       KitchenPriority @default(NORMAL)
  acceptedAt     DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  remarks        String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  assignedChef   User?           @relation(fields: [assignedChefId], references: [id], onDelete: Restrict)
  orderItem      OrderItem       @relation(fields: [orderItemId], references: [id])

  @@index([orderItemId])
  @@index([assignedChefId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("kitchen_queue")
}

model BarQueue {
  id                  Int         @id @default(autoincrement())
  orderItemId         Int         @unique
  assignedBartenderId Int?
  status              BarStatus   @default(PENDING)
  priority            BarPriority @default(NORMAL)
  acceptedAt          DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  remarks             String?     @db.Text
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  assignedBartender   User?       @relation(fields: [assignedBartenderId], references: [id], onDelete: Restrict)
  orderItem           OrderItem   @relation(fields: [orderItemId], references: [id])

  @@index([orderItemId])
  @@index([assignedBartenderId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("bar_queue")
}

model Settings {
  id                         Int          @id @default(autoincrement())
  restaurantName             String       @db.VarChar(200)
  slogan                     String?      @db.VarChar(255)
  logo                       String?      @db.LongText
  favicon                    String?      @db.VarChar(255)
  phone                      String       @db.VarChar(20)
  email                      String?      @db.VarChar(150)
  website                    String?      @db.VarChar(255)
  address                    String       @db.Text
  city                       String       @db.VarChar(100)
  country                    String       @db.VarChar(100)
  postalCode                 String?      @db.VarChar(20)
  currency                   CurrencyType
  currencySymbol             String       @db.VarChar(10)
  taxPercentage              Decimal      @default(0.00) @db.Decimal(5, 2)
  serviceCharge              Decimal      @default(0.00) @db.Decimal(5, 2)
  timezone                   String       @db.VarChar(100)
  language                   String       @db.VarChar(50)
  receiptHeader              String?      @db.Text
  receiptFooter              String?      @db.Text
  orderPrefix                String       @default("ORD") @db.VarChar(10)
  invoicePrefix              String       @default("INV") @db.VarChar(10)
  theme                      ThemeMode    @default(LIGHT)
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
  allowNegativeInventory     Boolean      @default(false)
  enableAutoWaiterAssignment Boolean      @default(true)
  enableAutoRiderAssignment  Boolean      @default(true)
  assignmentStrategy         String       @default("ROUND_ROBIN") @db.VarChar(50)
  autoAcceptOrders           Boolean      @default(false)
  autoComplete               Boolean      @default(false)
  autoDeductInventory        Boolean      @default(true)
  barPrinter                 String?      @db.VarChar(100)
  cashCounterPrinter         String?      @db.VarChar(100)
  dateFormat                 String       @default("YYYY-MM-DD") @db.VarChar(20)
  enable2Fa                  Boolean      @default(false)
  enableEmail                Boolean      @default(false)
  enablePush                 Boolean      @default(false)
  enableServiceCharges       Boolean      @default(true)
  enableSms                  Boolean      @default(false)
  enableTax                  Boolean      @default(true)
  enableWhatsapp             Boolean      @default(false)
  expiryAlert                Boolean      @default(true)
  jwtExpiry                  Int          @default(24)
  kitchenPrinter             String?      @db.VarChar(100)
  lowStockAlert              Boolean      @default(true)
  maxLoginAttempts           Int          @default(5)
  ntn                        String?      @db.VarChar(50)
  numberFormat               String       @default("en-US") @db.VarChar(20)
  passwordLength             Int          @default(8)
  preparationTime            Int          @default(15)
  printCashier               Boolean      @default(true)
  printOrderNumber           Boolean      @default(true)
  printTax                   Boolean      @default(true)
  sessionTimeout             Int          @default(60)
  showLogoOnReceipt          Boolean      @default(true)
  soundAlert                 Boolean      @default(true)
  strn                       String?      @db.VarChar(50)

  @@map("settings")
}

model Unit {
  id               Int          @id @default(autoincrement())
  name             String       @unique @db.VarChar(50)
  shortName        String       @unique @db.VarChar(10)
  unitType         UnitType
  isBaseUnit       Boolean      @default(false)
  conversionFactor Decimal      @default(1.0000) @db.Decimal(10, 4)
  displayOrder     Int          @default(0)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  ingredients      Ingredient[]
  recipes          Recipe[]

  @@map("units")
}

model Supplier {
  id             Int            @id @default(autoincrement())
  code           String         @unique @db.VarChar(30)
  name           String         @unique @db.VarChar(150)
  contactPerson  String?        @db.VarChar(150)
  phone          String?        @db.VarChar(20)
  email          String?        @db.VarChar(150)
  address        String?        @db.Text
  city           String?        @db.VarChar(100)
  taxNumber      String?        @db.VarChar(50)
  creditLimit    Decimal?       @db.Decimal(12, 2)
  currentBalance Decimal        @default(0.00) @db.Decimal(12, 2)
  rating         Int?
  logo           String?
  notes          String?        @db.Text
  status         SupplierStatus @default(ACTIVE)
  createdBy      Int
  updatedBy      Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  purchases      Purchase[]
  createdByUser  User           @relation("SupplierCreatedBy", fields: [createdBy], references: [id])
  updatedByUser  User           @relation("SupplierUpdatedBy", fields: [updatedBy], references: [id])

  @@index([code])
  @@index([name])
  @@index([phone])
  @@index([status])
  @@index([createdBy], map: "suppliers_createdBy_fkey")
  @@index([updatedBy], map: "suppliers_updatedBy_fkey")
  @@map("suppliers")
}

model Ingredient {
  id                Int             @id @default(autoincrement())
  code              String          @unique @db.VarChar(30)
  barcode           String?         @unique @db.VarChar(100)
  name              String          @unique @db.VarChar(150)
  image             String?         @db.VarChar(255)
  unitId            Int
  currentStock      Decimal         @default(0.000) @db.Decimal(12, 3)
  minimumStock      Decimal         @default(0.000) @db.Decimal(12, 3)
  costPrice         Decimal         @default(0.00) @db.Decimal(12, 2)
  lastPurchasePrice Decimal         @default(0.00) @db.Decimal(12, 2)
  isPerishable      Boolean         @default(true)
  isActive          Boolean         @default(true)
  createdBy         Int
  updatedBy         Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  createdByUser     User            @relation("IngredientCreatedBy", fields: [createdBy], references: [id])
  unit              Unit            @relation(fields: [unitId], references: [id])
  updatedByUser     User            @relation("IngredientUpdatedBy", fields: [updatedBy], references: [id])
  purchaseItems     PurchaseItem[]
  recipeItems       RecipeItem[]
  stockMovements    StockMovement[]

  @@index([code])
  @@index([name])
  @@index([unitId])
  @@index([isActive])
  @@index([currentStock])
  @@index([minimumStock])
  @@index([createdBy], map: "ingredients_createdBy_fkey")
  @@index([updatedBy], map: "ingredients_updatedBy_fkey")
  @@map("ingredients")
}

model Recipe {
  id                       Int           @id @default(autoincrement())
  menuItemId               Int
  version                  Int           @default(1)
  yieldQuantity            Decimal       @default(1.000) @db.Decimal(12, 3)
  yieldUnitId              Int?
  estimatedPreparationTime Int?
  recipeCost               Decimal?      @db.Decimal(12, 2)
  isAutoDeduct             Boolean       @default(true)
  notes                    String?       @db.Text
  isActive                 Boolean       @default(true)
  createdBy                Int
  updatedBy                Int
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  deletedAt                DateTime?
  MenuVariant              MenuVariant[]
  recipeItems              RecipeItem[]
  createdByUser            User          @relation("RecipeCreatedBy", fields: [createdBy], references: [id])
  menuItem                 MenuItem      @relation(fields: [menuItemId], references: [id])
  updatedByUser            User          @relation("RecipeUpdatedBy", fields: [updatedBy], references: [id])
  yieldUnit                Unit?         @relation(fields: [yieldUnitId], references: [id], onDelete: Restrict)

  @@index([menuItemId])
  @@index([version])
  @@index([isActive])
  @@index([createdBy], map: "recipes_createdBy_fkey")
  @@index([updatedBy], map: "recipes_updatedBy_fkey")
  @@index([yieldUnitId], map: "recipes_yieldUnitId_fkey")
  @@map("recipes")
}

model RecipeItem {
  id                     Int        @id @default(autoincrement())
  recipeId               Int
  ingredientId           Int
  quantity               Decimal    @db.Decimal(12, 3)
  wastagePercentage      Decimal    @default(0.00) @db.Decimal(5, 2)
  ingredientCostSnapshot Decimal?   @db.Decimal(12, 2)
  isOptional             Boolean    @default(false)
  affectsInventory       Boolean    @default(true)
  lossFactor             Decimal    @default(1.000) @db.Decimal(6, 3)
  displayOrder           Int        @default(0)
  notes                  String?    @db.Text
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  ingredient             Ingredient @relation(fields: [ingredientId], references: [id])
  recipe                 Recipe     @relation(fields: [recipeId], references: [id])

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@index([ingredientId])
  @@index([displayOrder])
  @@map("recipe_items")
}

model Purchase {
  id                Int            @id @default(autoincrement())
  purchaseNumber    String         @unique @db.VarChar(50)
  supplierId        Int
  invoiceNumber     String?        @db.VarChar(100)
  purchaseDate      DateTime       @db.Date
  expectedDate      DateTime?      @db.Date
  subtotal          Decimal        @db.Decimal(12, 2)
  discountAmount    Decimal        @default(0.00) @db.Decimal(12, 2)
  taxAmount         Decimal        @default(0.00) @db.Decimal(12, 2)
  shippingCost      Decimal        @default(0.00) @db.Decimal(12, 2)
  grandTotal        Decimal        @db.Decimal(12, 2)
  paymentStatus     PaymentStatus  @default(UNPAID)
  purchaseStatus    PurchaseStatus @default(DRAFT)
  approvedBy        Int?
  approvedAt        DateTime?
  receivedBy        Int?
  receivedAt        DateTime?
  source            PurchaseSource @default(MANUAL)
  invoiceAttachment String?        @db.VarChar(255)
  currency          String         @default("PKR") @db.VarChar(10)
  notes             String?        @db.Text
  createdBy         Int
  updatedBy         Int
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  purchaseItems     PurchaseItem[]
  createdByUser     User           @relation("PurchaseCreatedBy", fields: [createdBy], references: [id])
  supplier          Supplier       @relation(fields: [supplierId], references: [id])
  updatedByUser     User           @relation("PurchaseUpdatedBy", fields: [updatedBy], references: [id])

  @@index([purchaseNumber])
  @@index([supplierId])
  @@index([purchaseDate])
  @@index([paymentStatus])
  @@index([purchaseStatus])
  @@index([createdBy], map: "purchases_createdBy_fkey")
  @@index([updatedBy], map: "purchases_updatedBy_fkey")
  @@map("purchases")
}

model PurchaseItem {
  id               Int        @id @default(autoincrement())
  purchaseId       Int
  ingredientId     Int
  quantity         Decimal    @db.Decimal(12, 3)
  receivedQuantity Decimal    @default(0.000) @db.Decimal(12, 3)
  freeQuantity     Decimal    @default(0.000) @db.Decimal(12, 3)
  unitPrice        Decimal    @db.Decimal(12, 2)
  discountAmount   Decimal    @default(0.00) @db.Decimal(12, 2)
  taxAmount        Decimal    @default(0.00) @db.Decimal(12, 2)
  totalCost        Decimal    @db.Decimal(12, 2)
  expiryDate       DateTime?  @db.Date
  batchNumber      String?    @db.VarChar(100)
  notes            String?    @db.Text
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  ingredient       Ingredient @relation(fields: [ingredientId], references: [id])
  purchase         Purchase   @relation(fields: [purchaseId], references: [id])

  @@index([purchaseId])
  @@index([ingredientId])
  @@index([expiryDate])
  @@index([batchNumber])
  @@map("purchase_items")
}

model StockMovement {
  id            Int                @id @default(autoincrement())
  ingredientId  Int
  movementType  StockMovementType
  referenceType StockReferenceType
  referenceId   Int?
  quantity      Decimal            @db.Decimal(12, 3)
  balanceBefore Decimal            @db.Decimal(12, 3)
  balanceAfter  Decimal            @db.Decimal(12, 3)
  unitCost      Decimal?           @db.Decimal(12, 2)
  totalCost     Decimal?           @db.Decimal(12, 2)
  batchNumber   String?            @db.VarChar(100)
  remarks       String?            @db.Text
  createdBy     Int
  createdAt     DateTime           @default(now())
  createdByUser User               @relation("StockMovementCreatedBy", fields: [createdBy], references: [id])
  ingredient    Ingredient         @relation(fields: [ingredientId], references: [id])

  @@index([ingredientId])
  @@index([movementType])
  @@index([referenceType])
  @@index([referenceId])
  @@index([createdAt])
  @@index([createdBy], map: "stock_movements_createdBy_fkey")
  @@map("stock_movements")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  module      String   @db.VarChar(50)
  action      String   @db.VarChar(50)
  entityId    Int?
  description String?  @db.Text
  oldData     Json?
  newData     Json?
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id          Int                 @id @default(autoincrement())
  title       String              @db.VarChar(255)
  message     String              @db.Text
  type        NotificationType
  channel     NotificationChannel
  recipientId Int?
  isRead      Boolean             @default(false)
  sentAt      DateTime?
  createdAt   DateTime            @default(now())
  recipient   User?               @relation(fields: [recipientId], references: [id])

  @@index([recipientId])
  @@index([type])
  @@index([channel])
  @@index([isRead])
  @@map("notifications")
}

model Printer {
  id        Int         @id @default(autoincrement())
  name      String      @db.VarChar(100)
  type      PrinterType
  ipAddress String?     @db.VarChar(50)
  port      Int?
  isDefault Boolean     @default(false)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  printJobs PrintJob[]

  @@index([type])
  @@index([isActive])
  @@map("printers")
}

model PrintJob {
  id           Int            @id @default(autoincrement())
  printerId    Int
  orderId      Int?
  receiptId    String?        @db.VarChar(50)
  content      String         @db.Text
  status       PrintJobStatus @default(PENDING)
  copies       Int            @default(1)
  printedBy    Int?
  printedAt    DateTime?
  errorMessage String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  order        Order?         @relation(fields: [orderId], references: [id])
  user         User?          @relation(fields: [printedBy], references: [id])
  printer      Printer        @relation(fields: [printerId], references: [id])

  @@index([printerId])
  @@index([status])
  @@index([orderId])
  @@index([printedBy], map: "print_jobs_printedBy_fkey")
  @@map("print_jobs")
}

model Backup {
  id          Int          @id @default(autoincrement())
  fileName    String       @db.VarChar(255)
  filePath    String       @db.VarChar(500)
  fileSize    BigInt
  backupType  BackupType
  status      BackupStatus @default(PENDING)
  checksum    String?      @db.VarChar(255)
  createdById Int?
  createdAt   DateTime     @default(now())
  createdBy   User?        @relation(fields: [createdById], references: [id])

  @@index([createdAt])
  @@index([status])
  @@index([createdById], map: "backups_createdById_fkey")
  @@map("backups")
}

