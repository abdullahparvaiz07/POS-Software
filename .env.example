NODE_ENV=production

# Server Ports
PORT=5000
CLIENT_PORT=3000
NGINX_PORT=80

# Database Configuration
# This internal URL is used inside docker
DATABASE_URL=mysql://restaurant_user:restaurant_pass@mysql:3306/restaurant_pos
# External DB credentials (for initializing the MySQL container)
MYSQL_ROOT_PASSWORD=root_pass
MYSQL_DATABASE=restaurant_pos
MYSQL_USER=restaurant_user
MYSQL_PASSWORD=restaurant_pass

# JWT Secret
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# Redis Configuration
REDIS_URL=redis://redis:6379

# Client
CLIENT_URL=http://localhost

# Optional: SMTP Configuration for email
SMTP_HOST=smtp.mailtrap.io
SMTP_USER=user
SMTP_PASS=pass
